import flpianoroll as flp

def createDialog():
    form = flp.ScriptDialog(
        "Moises MIDI Cleaner & MPC Mapper",
        "Deletes Moises stem-bleed ghost notes and optionally snaps drum MIDI to MPC 3 Beats Pad Bank A."
    )
    form.AddInputKnobInt("Min Note Length (Ticks)", 12, 1, 48)
    form.AddInputKnob("Min Velocity Gate", 0.18, 0.01, 0.50)
    form.AddInputCheckbox("Remap Pitches to MPC 3 Pads (C3/D3/F#3)", False)
    return form

def apply(form):
    min_len = form.GetInputValue("Min Note Length (Ticks)")
    min_vel = form.GetInputValue("Min Velocity Gate")
    remap_mpc = form.GetInputValue("Remap Pitches to MPC 3 Pads (C3/D3/F#3)")

    for i in range(flp.score.noteCount - 1, -1, -1):
        note = flp.score.getNote(i)

        if note.length <= min_len or note.velocity <= min_vel:
            flp.score.deleteNote(i)
            continue

        if remap_mpc:
            if note.number <= 45:
                note.number = 36  # MPC Pad A01 (Kick - C3 in FL)
            elif note.number <= 64:
                note.number = 38  # MPC Pad A03 (Snare - D3 in FL)
            else:
                note.number = 42  # MPC Pad A07 (Closed Hat - F#3 in FL)

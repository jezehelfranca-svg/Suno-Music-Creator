import flpianoroll as flp
import math
import random

def createDialog():
    form = flp.ScriptDialog(
        "AI-to-Human Groove Injector",
        "Applies Gaussian timing drift, chord strum offsets, and velocity humanization."
    )
    form.AddInputKnobInt("Timing Jitter (Ticks)", 6, 0, 24)
    form.AddInputKnobInt("Chord Strum (Ticks)", 4, 0, 16)
    form.AddInputKnob("Velocity Spread", 0.08, 0.0, 0.25)
    form.AddInputCheckbox("Pull Backbeat (Laid-Back Feel)", True)
    return form

def gaussian_rand(mean, std_dev):
    u1 = max(1e-7, random.random())
    u2 = random.random()
    z0 = math.sqrt(-2.0 * math.log(u1)) * math.cos(2.0 * math.pi * u2)
    return mean + z0 * std_dev

def apply(form):
    jitter_max = form.GetInputValue("Timing Jitter (Ticks)")
    strum_ticks = form.GetInputValue("Chord Strum (Ticks)")
    vel_spread = form.GetInputValue("Velocity Spread")
    pull_backbeat = form.GetInputValue("Pull Backbeat (Laid-Back Feel)")

    count = flp.score.noteCount
    if count == 0:
        return

    notes_by_time = {}
    for i in range(count):
        note = flp.score.getNote(i)
        notes_by_time.setdefault(note.time, []).append(note)

    for start_time, chord_notes in notes_by_time.items():
        chord_notes.sort(key=lambda n: n.number)
        
        for idx, note in enumerate(chord_notes):
            tick_offset = int(gaussian_rand(0, jitter_max / 2.0))
            
            if len(chord_notes) >= 3:
                tick_offset += idx * strum_ticks
                
            if pull_backbeat:
                ppq = flp.score.PPQ
                beat_pos = (note.time // ppq) % 4
                if beat_pos in (1, 3):
                    tick_offset += 3

            note.time = max(0, note.time + tick_offset)

            vel_delta = gaussian_rand(0, vel_spread)
            if len(chord_notes) >= 3 and idx == len(chord_notes) - 1:
                vel_delta += 0.04
            note.velocity = max(0.10, min(0.98, note.velocity + vel_delta))
            
            len_jitter = int(gaussian_rand(0, 4))
            note.length = max(12, note.length + len_jitter)
